#!/usr/bin/env python3

import os
import sys
import platform
import subprocess
from pathlib import Path


NOVA_HOME = Path.home() / "NOVA"


def check_command(name):
    return subprocess.run(
        ["bash", "-c", f"command -v {name}"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL
    ).returncode == 0


def inspect():
    print("=" * 60)
    print("                 NOVA INSPECT")
    print("=" * 60)

    print("\nHOST")
    print(f"✓ {platform.system()} {platform.release()}")
    print(f"✓ Architecture: {platform.machine()}")

    print("\nWORKSPACE")
    print(f"✓ {NOVA_HOME}")

    folders = [
        "showcase",
        "review",
        "core",
        "config",
        "logs"
    ]

    for folder in folders:
        path = NOVA_HOME / folder
        print(f"{'✓' if path.exists() else '✗'} {folder}")

    print("\nTOOLS")

    tools = [
        "git",
        "gh",
        "podman",
        "python3",
        "nvim"
    ]

    for tool in tools:
        print(f"{'✓' if check_command(tool) else '✗'} {tool}")

    print("\nPROJECTS")

    projects = NOVA_HOME / "showcase"

    if projects.exists():
        for project in projects.iterdir():
            if project.is_dir():
                print(f"✓ {project.name}")
    else:
        print("No projects found")

    print("\nCONTAINERS")

    result = subprocess.run(
        ["podman", "ps", "--format", "{{.Names}}\t{{.Status}}"],
        capture_output=True,
        text=True
    )

    if result.stdout.strip():
        print(result.stdout)
    else:
        print("No active containers")

    print("\nSTATUS")
    print("✓ NOVA core initialized")
    print("✓ Awaiting agent modules")


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "inspect":
        inspect()
    else:
        inspect()


if __name__ == "__main__":
    main()
