# ===== NOVA — Personal AI Assistant Backend Configuration =====

# ===== Required Secrets (set in production) =====
JWT_SECRET=nova-dev-jwt-secret-change-in-production-2024
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=

# ===== Database =====
MONGO_URL=mongodb://localhost:27017
DB_NAME=nova_assistant

# ===== CORS Origins =====
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ===== LLM Backend Selection =====
# Primary: ollama (local, free, requires running Ollama)
# Fallback: emergent (cloud via EMERGENT_LLM_KEY)
LLM_BACKEND=ollama

# ===== OpenRouter (Free models available - alternative primary) =====
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-2-7b-chat

# ===== Emergent Integrations (for GPT-5.2, Claude, Gemini cloud models) =====
EMERGENT_LLM_KEY=

# ===== Ollama (Local LLM - no API key required) =====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODELS=llama3.1:8b,dolphin-mixtral:8x7b

# ===== OpenAI (Fallback - requires API key) =====
OPENAI_API_KEY=

# ===== Server Configuration =====
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
LOG_LEVEL=INFO

# ===== Frontend URL (for redirects) =====
FRONTEND_URL=http://localhost:3000
